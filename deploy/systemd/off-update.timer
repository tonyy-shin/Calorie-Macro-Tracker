# Phase 8: run off-update.service once a day.
# Persistent=true: if the laptop was off or asleep at the scheduled time,
# run as soon as it's back. Missed days are caught up automatically, since
# the job applies every delta file it hasn't applied yet (OFF keeps 14 days).
# @author Tony Shin <tonyshin4065@gmail.com>

[Unit]
Description=Daily Open Food Facts update for Calorie-Macro-Tracker

[Timer]
OnCalendar=*-*-* 07:15
RandomizedDelaySec=20min
Persistent=true

[Install]
WantedBy=timers.target
